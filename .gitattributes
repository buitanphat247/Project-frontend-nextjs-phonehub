# Git attributes - Đảm bảo Git xử lý encoding đúng
# https://git-scm.com/docs/gitattributes

# Tự động detect text files và normalize line endings
* text=auto

# Đảm bảo Markdown files luôn dùng UTF-8
*.md text eol=lf charset=utf-8

# Đảm bảo các file text khác dùng UTF-8
*.txt text eol=lf charset=utf-8
*.json text eol=lf charset=utf-8
*.yml text eol=lf charset=utf-8
*.yaml text eol=lf charset=utf-8

# Source code files
*.js text eol=lf charset=utf-8
*.jsx text eol=lf charset=utf-8
*.ts text eol=lf charset=utf-8
*.tsx text eol=lf charset=utf-8
*.css text eol=lf charset=utf-8
*.scss text eol=lf charset=utf-8
*.html text eol=lf charset=utf-8

# Config files
*.config.* text eol=lf charset=utf-8
*.config text eol=lf charset=utf-8

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

